# Copy to backend/.env and set real values. Never put these in the Flutter app.
# Accounts + farm data are stored in Firebase only (no local SQLite / memory).

AUTH_ADMIN_EMAIL=your-admin@gmail.com
AUTH_ADMIN_PASSWORD=replace-with-a-strong-password-1
AUTH_WORKER_EMAIL=
AUTH_WORKER_PASSWORD=
AUTH_SALES_EMAIL=your-seller@gmail.com
AUTH_SALES_PASSWORD=replace-with-a-strong-password-1

# Farm LAN or public tunnel — never localhost / 127.0.0.1
AUTH_PUBLIC_BASE_URL=http://192.168.11.212:8000

# Comma-separated browser origins for Flutter web (never use * in production)
# CORS_ALLOW_ORIGINS=https://egg-system.paghasianjustine.workers.dev,https://egg-farm.eggsorting.site

# Shared secret for ESP32 → POST /weight and /api/status (header X-Farm-Device-Token)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
FARM_DEVICE_TOKEN=

# Gmail SMTP — App Password for the sender mailbox (never commit the real password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Egg System Firebase project — required for all account/farm storage
FIREBASE_PROJECT_ID=egg-system-c36f5
# Required for Firestore (Project settings → General → Web API Key)
FIREBASE_WEB_API_KEY=
# Backend signs into Firebase Auth so Firestore rules allow REST writes
FIREBASE_BACKEND_EMAIL=your-admin@gmail.com
FIREBASE_BACKEND_PASSWORD=replace-with-a-strong-password-1

# Optional: ESP32-CAM MJPEG URL printed by the station firmware
# ESP32_STREAM_URL=http://192.168.x.x:81/stream

# Roboflow Serverless — egg defect model (never commit the real key)
ROBOFLOW_API_URL=https://serverless.roboflow.com
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=egg-defect-detection-sznlj/1
